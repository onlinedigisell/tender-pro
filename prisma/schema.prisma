generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tender {
  id          String   @id @default(uuid())
  title       String
  department  String
  location    String
  value       Float?
  startDate   DateTime
  endDate     DateTime
  status      String
  createdAt   DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  status    String
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TenderSource {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tender {
  id                  String    @id @default(uuid())
  title               String
  department          String
  location            String
  value               Float?
  startDate           DateTime
  endDate             DateTime
  status              String
  onlineLink          String?
  bidDecision         String    @default("PENDING")
  documentPrepared    Boolean   @default(false)
  bidSubmitted        Boolean   @default(false)
  quotedRate          Float?
  actualTenderCost    Float?
  tenderExpense       Float?
  resultStatus        String    @default("PENDING")
  workCompleted       Boolean   @default(false)
  workDoneCertificate Boolean   @default(false)
  completionDate      DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  bidders             Bidder[]
}

model Bidder {
  id            String   @id @default(uuid())
  tenderId      String
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  bidderName    String
  contactPerson String?
  phone         String?
  quotedAmount  Float?
  percentBelow  Float?
  rank          Int?
  isWinner      Boolean  @default(false)
  remarks       String?
  createdAt     DateTime @default(now())

  @@index([tenderId])
}

model RfpAnalysis {
  id                 String   @id @default(uuid())
  fileName           String
  tenderTitle        String?
  department         String?
  tenderValue        String?
  summary            String?
  liveDate           String?
  openingDate        String?
  submissionDate     String?
  lastDate           String?
  eligibility        String?
  evaluationMethod   String?
  markingSystem      String?
  requiredDocuments  String?
  physicalSubmission String?
  emdAmount          String?
  tenderFee          String?
  similarWork        String?
  technicalRequirements String?
  financialRequirements String?
  importantClauses   String?
  riskyClauses       String?
  keyCriteria        String?
  rawText            String?
  createdAt          DateTime @default(now())
}

model Activity {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  status    String
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TenderSource {
  id              String           @id @default(uuid())
  name            String
  url             String
  createdAt       DateTime         @default(now())
  lastFetchedAt   DateTime?
  externalTenders ExternalTender[]
}

model ExternalTender {
  id        String       @id @default(uuid())
  sourceId  String
  source    TenderSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title     String
  link      String
  summary   String?
  status    String       @default("NEW")
  fetchedAt DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@unique([sourceId, link])
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

{
  "manifest_version": 3,
  "name": "Tender Pro MahaTender Sync",
  "version": "1.0.0",
  "description": "Sync visible MahaTender tender data into Tender Pro after manual login and CAPTCHA.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.mahatenders.gov.in/*",
    "https://mahatenders.gov.in/*",
    "https://tender-pro-gamma.vercel.app/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tender Pro Sync"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
